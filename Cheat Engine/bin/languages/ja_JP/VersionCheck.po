#: VC-U2CVICNEL
msgid "Unable to check version (Invalid content, not enough lines)"
msgstr "バージョンを確認できません (無効なコンテンツ、行数不足)"

#: VC-U2CVIC
msgid "Unable to check version (Invalid content)"
msgstr "バージョンを確認できません (無効なコンテンツ)"

#: VC-CFNV
msgid "Check for new version"
msgstr "新バージョンの確認"

#: VC-NCA
