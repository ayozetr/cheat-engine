#: VC-UP2D
msgid "You are up to date. The latest version is %s"
msgstr "最新バージョンです。最新バージョンは %s です"

#: VC-WTF
msgid "Unable to check version (Can't connect)"
msgstr "バージョンを確認できません (接続できません)"

#: VC-UPDATETO
msgid "Update to %s"
msgstr "%s に更新"

#: VC-UPDATETO
msgid "In how many days should I notify you again?"
msgstr "次回の通知は何日後にしますか？"

#: VC-SETTINGS-TEXT
msgid "Check for updates when Cheat Engine starts"
msgstr "Cheat Engine 起動時にアップデートを確認"

#: VC-INTERVAL
msgid "Interval(days):"
msgstr "間隔 (日) :"
